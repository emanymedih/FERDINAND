{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FERDINAND ToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "summary",
    "data",
    "source_refs",
    "uncertainties",
    "actions",
    "metrics"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "needs_review",
        "awaiting_approval",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "object_id",
          "locator",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "type",
          "state",
          "approval_id"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "enum": [
              "proposed",
              "approved",
              "executed",
              "rejected",
              "failed"
            ]
          },
          "approval_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
