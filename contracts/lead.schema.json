{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FERDINAND Lead candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lead_id",
    "source_ref",
    "received_at",
    "classification",
    "review_status",
    "customer",
    "request",
    "uncertainties",
    "field_provenance"
  ],
  "properties": {
    "lead_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "object_id",
        "locator",
        "retrieved_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "enum": [
        "request",
        "question",
        "document",
        "other",
        "uncertain"
      ]
    },
    "review_status": {
      "enum": [
        "candidate",
        "needs_review",
        "confirmed",
        "rejected"
      ]
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "contact": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "quantity",
        "unit",
        "deadline"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "locator",
          "quote"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    }
  }
}
